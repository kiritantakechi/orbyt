/*
 * A/B slot logic (r4s-ab-rollback D3), built into every board's and the
 * emulator's U-Boot after their board constants (board-model D3): orbyt_mmc (the
 * boot disk's MMC device), orbyt_console (the console arguments) and orbyt_bootos
 * (how to start the kernel in a slot's FIT).
 *
 * Only boot_slot, bootcount and upgrade_available are read from the stored
 * environment (ENV_WRITEABLE_LIST), so the logic always comes from this binary.
 * bootcmd runs orbyt_boot; once bootcount exceeds bootlimit during a trial boot,
 * altbootcmd runs orbyt_rollback instead (both set in orbyt-ab.config).
 */

/*
 * Boot boot_slot: a unless it is b. Partitions: boot-A 1, root-A 2, boot-B 3, root-B 4.
 * Linux learns the running slot (orbyt.slot) and where this bootloader keeps the
 * copies of its environment (orbyt.env, size@offset each), the only places it may
 * write them (trial-boot-resilience D2).
 */
orbyt_boot=
	if test "${boot_slot}" = b; then
		setenv orbyt_bp 3; setenv orbyt_rp 4;
	else
		setenv boot_slot a; setenv orbyt_bp 1; setenv orbyt_rp 2;
	fi;
	part uuid mmc ${orbyt_mmc}:${orbyt_rp} orbyt_root;
	setenv bootargs ${orbyt_console} root=PARTUUID=${orbyt_root} rw rootwait
		panic=5 watchdog.open_timeout=90 orbyt.slot=${boot_slot}
		orbyt.env=CONFIG_ENV_SIZE@CONFIG_ENV_OFFSET,CONFIG_ENV_SIZE@CONFIG_ENV_OFFSET_REDUND
		fstools_overlay_compression_type=zstd;
	if load mmc ${orbyt_mmc}:${orbyt_bp} ${kernel_addr_r} kernel.img; then
		run orbyt_bootos;
	fi;
	run orbyt_fallback

/* The slot did not start: try the other one once in this power cycle, then stop. */
orbyt_fallback=
	if test -z "${orbyt_tried}"; then
		setenv orbyt_tried 1; run orbyt_other; run orbyt_boot;
	else
		echo orbyt: neither slot boots, stopping at the prompt;
	fi

/* The trial slot never got confirmed: go back to the other slot for good. */
orbyt_rollback=
	run orbyt_other;
	setenv upgrade_available 0; setenv bootcount 0; saveenv;
	run orbyt_boot

orbyt_other=
	if test "${boot_slot}" = b; then setenv boot_slot a; else setenv boot_slot b; fi
