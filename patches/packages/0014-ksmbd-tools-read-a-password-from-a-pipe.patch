From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kiritantakechi <kiritantakechi@gmail.com>
Date: Sun, 15 Nov 2026 21:00:00 +0800
Subject: [PATCH] ksmbd-tools: read a password from a pipe

ksmbd.adduser takes a password either as -p's argument, on the command
line, where any local user reads it from /proc/<pid>/cmdline while it
runs, or at its prompt. The prompt also reads a pipe, but it handles a
random byte as backspace there: tcgetattr() fails on a pipe and leaves
the terminal settings uninitialized, whose erase character the prompt
still compares every byte with, so a piped password can be stored
altered without an error.

Add upstream's fix, which configures and reads the terminal's settings
only when standard input is one, ahead of its next release: a program
can then pass the password typed twice on standard input.

Signed-off-by: kiritantakechi <kiritantakechi@gmail.com>
Upstream-Status: Backport [ksmbd-tools 317406794f32, unreleased after 3.5.7]
---
 net/ksmbd-tools/Makefile                      |  2 +-
 ...dduser-read-the-password-from-a-pipe.patch | 76 +++++++++++++++++++
 2 files changed, 77 insertions(+), 1 deletion(-)
 create mode 100644 net/ksmbd-tools/patches/040-adduser-read-the-password-from-a-pipe.patch

diff --git a/net/ksmbd-tools/Makefile b/net/ksmbd-tools/Makefile
index c1b26d8..63c4b0f 100644
--- a/net/ksmbd-tools/Makefile
+++ b/net/ksmbd-tools/Makefile
@@ -2,7 +2,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=ksmbd-tools
 PKG_VERSION:=3.5.7
-PKG_RELEASE:=4
+PKG_RELEASE:=5
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.gz
 PKG_SOURCE_URL:=https://github.com/cifsd-team/ksmbd-tools/releases/download/$(PKG_VERSION)
diff --git a/net/ksmbd-tools/patches/040-adduser-read-the-password-from-a-pipe.patch b/net/ksmbd-tools/patches/040-adduser-read-the-password-from-a-pipe.patch
new file mode 100644
index 0000000..e58e946
--- /dev/null
+++ b/net/ksmbd-tools/patches/040-adduser-read-the-password-from-a-pipe.patch
@@ -0,0 +1,76 @@
+From 317406794f32b0e6dfbecc142f30ab9837fff4be Mon Sep 17 00:00:00 2001
+From: Andrea Pesaresi <andreapesaresi82@gmail.com>
+Date: Sat, 17 Oct 2026 20:30:48 +0200
+Subject: [PATCH] adduser: read the password from a pipe
+
+When stdin is not a terminal, tcgetattr() fails and term is left
+uninitialized. raw_term.c_cc[VERASE] then holds a random byte, which is
+handled as backspace whenever it shows up in the password, so a password
+piped to ksmbd.adduser can be stored altered without any error.
+
+Only switch the terminal to raw mode, handle the erase character and
+restore the settings when stdin is a terminal. This lets programs pass
+the password on stdin, typed twice as at the prompt, instead of putting
+it on the command line, where any local user can read it from
+/proc/<pid>/cmdline:
+
+  printf 'pass word\npass word\n' | ksmbd.adduser -a user
+
+The stored hash then matches the one written by -p 'pass word'.
+
+Signed-off-by: Andrea Pesaresi <andreapesaresi82@gmail.com>
+Signed-off-by: Namjae Jeon <linkinjeon@kernel.org>
+---
+ adduser/user_admin.c | 20 +++++++++++++++-----
+ 1 file changed, 15 insertions(+), 5 deletions(-)
+
+diff --git a/adduser/user_admin.c b/adduser/user_admin.c
+index 59c13360..b7be95c7 100644
+--- a/adduser/user_admin.c
++++ b/adduser/user_admin.c
+@@ -29,14 +29,23 @@ static void __prompt_password_stdin(char *password, size_t *sz)
+ 	struct termios term, raw_term;
+ 	char buf[LINE_MAX];
+ 	size_t buflen;
++	int is_tty;
+ 
+ 	pr_info("Prompting for password\n");
+ 
+-	tcgetattr(STDIN_FILENO, &term);
++	/*
++	 * stdin can be a pipe, e.g. when a program passes the password
++	 * without putting it on the command line. There is no terminal
++	 * to configure then, and term would be left uninitialized.
++	 */
++	memset(&term, 0, sizeof(term));
++	is_tty = !tcgetattr(STDIN_FILENO, &term);
+ 	raw_term = term;
+ 
+-	raw_term.c_lflag &= ~(ECHO | ICANON);
+-	tcsetattr(STDIN_FILENO, TCSAFLUSH, &raw_term);
++	if (is_tty) {
++		raw_term.c_lflag &= ~(ECHO | ICANON);
++		tcsetattr(STDIN_FILENO, TCSAFLUSH, &raw_term);
++	}
+ 
+ 	for (*sz = (size_t)-1,
+ 	     buflen = 0, password[buflen] = buf[buflen] = 0x00;;) {
+@@ -82,7 +91,7 @@ static void __prompt_password_stdin(char *password, size_t *sz)
+ 			break;
+ 		}
+ 
+-		if (c == raw_term.c_cc[VERASE]) {
++		if (is_tty && c == raw_term.c_cc[VERASE]) {
+ 			char *u8c;
+ 			size_t clen;
+ 
+@@ -103,7 +112,8 @@ static void __prompt_password_stdin(char *password, size_t *sz)
+ 
+ 	printf("\eD" "\r" "\e[2K");
+ 
+-	tcsetattr(STDIN_FILENO, TCSAFLUSH, &term);
++	if (is_tty)
++		tcsetattr(STDIN_FILENO, TCSAFLUSH, &term);
+ }
+ 
+ static int __is_valid_password_len(size_t len)
