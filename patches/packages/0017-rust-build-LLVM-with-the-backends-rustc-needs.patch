From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kiritantakechi <kiritantakechi@gmail.com>
Date: Sat, 21 Nov 2026 14:00:00 +0800
Subject: [PATCH] rust: build LLVM with the backends rustc needs

rust/host builds LLVM for every backend it has, most of the host
toolchain's two hours. rustc needs the host's, for build scripts and
procedural macros, the target's, and BPF's, which Rust's eBPF programs
compile to: build these three, or every backend as before when the
host's or the target's is not known.

Signed-off-by: kiritantakechi <kiritantakechi@gmail.com>
Upstream-Status: Inappropriate [the backends this tree's Rust programs compile for]
---
 lang/rust/Makefile | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/lang/rust/Makefile b/lang/rust/Makefile
index 57aba99..73ee0cf 100644
--- a/lang/rust/Makefile
+++ b/lang/rust/Makefile
@@ -62,7 +62,21 @@ HOST_CONFIGURE_VARS += CARGO_HOME="$(CARGO_HOME)"
 
 # The host toolchain, with the standard library for the target, is built once
 # for every target of the same architecture and shared like any host package,
-# in build_dir/hostpkg and staging_dir/hostpkg.
+# in build_dir/hostpkg and staging_dir/hostpkg. Its LLVM has the backends of
+# the host, for build scripts and procedural macros, of the target, and BPF,
+# which Rust's eBPF programs compile to.
+rust_llvm_target=$(strip \
+  $(if $(filter aarch64%,$(1)),AArch64, \
+  $(if $(filter x86_64 i386 i486 i586 i686,$(1)),X86, \
+  $(if $(filter arm%,$(1)),ARM, \
+  $(if $(filter mips%,$(1)),Mips, \
+  $(if $(filter powerpc%,$(1)),PowerPC, \
+  $(if $(filter riscv%,$(1)),RISCV, \
+  $(if $(filter loongarch%,$(1)),LoongArch))))))))
+# Built for every backend, as upstream does, when one of the two is not known.
+RUST_LLVM_HOST:=$(call rust_llvm_target,$(HOST_ARCH))
+RUST_LLVM_TARGET:=$(call rust_llvm_target,$(ARCH))
+RUST_LLVM_TARGETS:=$(if $(and $(RUST_LLVM_HOST),$(RUST_LLVM_TARGET)),$(subst $(space),;,$(sort $(RUST_LLVM_HOST) $(RUST_LLVM_TARGET) BPF)))
 
 # Rust Configuration Arguments
 HOST_CONFIGURE_ARGS = \
@@ -81,6 +95,7 @@ HOST_CONFIGURE_ARGS = \
 	--enable-cargo-native-static \
 	--bootstrap-cache-path=$(DL_DIR)/rustc \
 	--set=llvm.download-ci-llvm=false \
+	$(if $(RUST_LLVM_TARGETS),'--set=llvm.targets=$(RUST_LLVM_TARGETS)' --set=llvm.experimental-targets=) \
 	$(if $(CONFIG_CCACHE),--set=build.ccache=$(STAGING_DIR_HOST)/bin/ccache) \
 	$(TARGET_CONFIGURE_ARGS)
 
