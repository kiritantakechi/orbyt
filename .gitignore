# What runs inside the checkout leaves there; the build's tree and its outputs
# live outside it ($ORBYT_WORKDIR).
# nix build's links to its results
/result
/result-*
# Claude Code's worktrees of this repository
/.claude/worktrees/
.DS_Store
# The tests project's Python state: uv's environment when uv runs there without
# the one use_tests_venv names, bytecode, pytest's and ruff's caches, and the
# reports of the runs.
/tests/.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
/tests/.reports/
