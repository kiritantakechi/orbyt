diff --git a/crates/honk-core/src/control/nfqueue/tests.rs b/crates/honk-core/src/control/nfqueue/tests.rs
index 08e38bb..a5a4b8e 100644
--- a/crates/honk-core/src/control/nfqueue/tests.rs
+++ b/crates/honk-core/src/control/nfqueue/tests.rs
@@ -632,6 +632,46 @@ async fn the_watchdog_retires_a_batch_of_token_cleanups_a_tick() {
     shed.assert_retired().await;
 }
 
+/// Flows shed faster than they can be retired fill the scheduled set: a token
+/// cleanup it has no room for is left to the janitor and counted, and a flow
+/// cleanup, one per cell, still has room.
+#[tokio::test]
+async fn a_full_cleanup_set_leaves_token_cleanups_to_the_janitor() {
+    let key = |index: usize| {
+        FlowKey::new(
+            SocketAddr::from(([192, 0, 2, 10], 20_000 + u16::try_from(index).unwrap())),
+            "198.51.100.20:443".parse().unwrap(),
+        )
+    };
+    let backend: Arc<RwLock<Box<dyn EbpfBackend>>> = Arc::new(RwLock::new(Box::new(
+        crate::ebpf::mock::MockEbpfBackend::new(),
+    )));
+    let stats = Arc::new(StatsManager::new());
+    let (pending, mut fatal) = PendingUdpVerdicts::new(
+        backend,
+        Arc::new(UdpEndpointPool::new()),
+        Arc::clone(&stats),
+    );
+    for index in 0..=MAX_SCHEDULED_CLEANUPS {
+        pending.schedule_cleanup(CleanupRequest::Token {
+            key: key(index),
+            decision_token: 100 + u32::try_from(index).unwrap(),
+        });
+    }
+    let flow = CleanupRequest::Flow(PendingUdpIdentity::new(
+        key(0),
+        crate::ebpf::UdpFlowOwner::new(1, None).unwrap(),
+        0,
+    ));
+    pending.schedule_cleanup(flow);
+
+    let scheduled = pending.scheduled_cleanups.lock();
+    assert_eq!(scheduled.len(), MAX_SCHEDULED_CLEANUPS + 1);
+    assert!(scheduled.contains(&flow));
+    assert_eq!(stats.udp_snapshot().nfqueue.cleanup_full, 1);
+    assert!(fatal.try_recv().is_err());
+}
+
