diff --git a/crates/honk-core/src/control/nfqueue/watchdog.rs b/crates/honk-core/src/control/nfqueue/watchdog.rs
index 451fb3a..33db3ba 100644
--- a/crates/honk-core/src/control/nfqueue/watchdog.rs
+++ b/crates/honk-core/src/control/nfqueue/watchdog.rs
@@ -370,17 +370,24 @@ impl PendingUdpVerdicts {
         }
     }
 
+    /// Schedule a cleanup. A flow cleanup always has room: it settles one of
+    /// the correlator's cells, so they never outnumber them. A token cleanup
+    /// only hastens the retirement of staging the kernel keeps fenced by its
+    /// token, which expires 120 s after the flow's first packet, as the
+    /// staging of a packet the kernel's queue dropped does: until then the
+    /// flow's packets are queued and dropped. A token cleanup the full set
+    /// has no room for is left to that expiry and the janitor, and counted, as
+    /// the correlator counts the packets it has no room for.
     pub(super) fn schedule_cleanup(&self, request: CleanupRequest) {
         let mut requests = self.scheduled_cleanups.lock();
         if requests.contains(&request) {
             return;
         }
-        if requests.len() >= MAX_SCHEDULED_CLEANUPS {
+        if matches!(request, CleanupRequest::Token { .. })
+            && requests.len() >= MAX_SCHEDULED_CLEANUPS
+        {
             drop(requests);
-            self.signal_fatal(PendingUdpFatal::new(
-                "cleanup scheduling",
-                "scheduled cleanup set reached NFQUEUE maxlen",
-            ));
+            self.stats.record_udp_nfqueue_cleanup_full();
             return;
         }
         requests.insert(request);
