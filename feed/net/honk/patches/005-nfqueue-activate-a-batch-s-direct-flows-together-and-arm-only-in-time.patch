 pub(super) const HARD_HOLD_TIMEOUT: Duration = Duration::from_secs(3);
+/// What arming must leave of a flow's hold beyond the rest of its batch's
+/// commit and the batch's activation work: the backend acquisition and the
+/// scheduling around it.
+pub(super) const ACTIVATION_MARGIN: Duration = Duration::from_millis(300);
+/// The least that arming leaves of a flow's hold. An armed flow that misses
+/// its hold is fatal, and under load the work and waits between arming and
+/// activation outgrow what the measured work foretells (to a second on an
+/// emulated R4S under host load, where flows armed with less left missed
+/// their hold): a flow past half its hold is not armed.
+pub(super) const ACTIVATION_RESERVE_MIN: Duration =
+    Duration::from_millis((HARD_HOLD_TIMEOUT.as_millis() / 2) as u64);
+/// The most that arming withholds, all of the hold but the margin: a flow
+/// fresh from the queue is always armed, which also keeps the measured
+/// commit and activation work current.
+pub(super) const ACTIVATION_RESERVE_MAX: Duration =
+    HARD_HOLD_TIMEOUT.saturating_sub(ACTIVATION_MARGIN);
 const MAX_SCHEDULED_CLEANUPS: usize = honk_nfqueue::QUEUE_MAXLEN as usize;
 const MAX_CORRELATOR_FLOWS: usize = honk_nfqueue::QUEUE_MAXLEN as usize;
 const MAX_HELD_VERDICTS_PER_FLOW: usize = 64;
