+
+/// The fixture's flow and `count` more, each with `remaining` of its hold
+/// left and one held original; return the more flows' leases and identities.
+fn staged(
+    mut mock: MockEbpfBackend,
+    count: u16,
+    remaining: Duration,
+) -> (DecisionFixture, Vec<(UdpInitLease, PendingUdpIdentity)>) {
+    let keys: Vec<_> = (1..=count)
+        .map(|port| {
+            FlowKey::new(
+                std::net::SocketAddr::from(([192, 0, 2, 10], 40000 + port)),
+                "198.51.100.20:443".parse().unwrap(),
+            )
+        })
+        .collect();
+    for (key, token) in keys.iter().zip(100..) {
+        mock.seed_staged_udp_flow(
+            &key.tuples(),
+            retained(
+                token,
+                UdpDecisionState::Pending,
+                ROUTING_META_FLAG_PUBLISHED,
+            ),
+        );
+    }
+    let fixture = pending_fixture_with(41, mock);
+    deadline(&fixture, remaining);
+    let flows = keys
+        .into_iter()
+        .zip(100..)
+        .map(|(key, token)| {
+            let lease = match fixture.pending.endpoints.reserve_owned_or_enqueue(
+                key.client,
+                key.destination,
+                bytes::Bytes::from_static(b"more"),
+                token,
+                None,
+                test_flow_slot(),
+                &fixture.stats,
+            ) {
+                EndpointReservation::Initializing(lease) => lease,
+                _ => panic!("each flow must initialize"),
+            };
+            let identity = PendingUdpVerdicts::identity_for_lease(&lease);
+            fixture.pending.cells.insert(
+                key,
+                Arc::new(FlowCell::pending(
+                    identity,
+                    Instant::now() - HARD_HOLD_TIMEOUT + remaining,
+                    HeldVerdict::test(u64::from(token), Instant::now(), Arc::clone(&fixture.sink)),
+                    Arc::clone(&fixture.pending.flow_slots)
+                        .try_acquire_owned()
+                        .unwrap(),
+                )),
+            );
+            fixture.stats.increment_udp_nfqueue_active_flows();
+            (lease, identity)
+        })
+        .collect();
+    (fixture, flows)
+}
+
+/// Direct flows decided together are activated together: one backend
+/// acquisition for the batch, not one for each flow behind whatever holds the
+/// backend meanwhile (the janitor's scans hold it for reading).
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn direct_flows_decided_together_are_activated_together() {
+    let (fixture, flows) = staged(MockEbpfBackend::new(), 19, Duration::from_millis(2000));
+    let scanning = Arc::new(std::sync::atomic::AtomicBool::new(true));
+    let scanner = tokio::task::spawn_blocking({
+        let backend = Arc::clone(&fixture.backend);
+        let scanning = Arc::clone(&scanning);
+        move || {
+            while scanning.load(Ordering::Acquire) {
+                let scan = backend.blocking_read();
+                std::thread::sleep(Duration::from_millis(150));
+                drop(scan);
+            }
+        }
+    });
+    let decisions = std::iter::once(fixture.pending.activate_direct(
+        fixture.identity,
+        fixture.lease,
+        0x1200,
+    ))
+    .chain(
+        flows
+            .into_iter()
+            .map(|(lease, identity)| fixture.pending.activate_direct(identity, lease, 0x1200)),
+    );
+    let results = futures::future::join_all(decisions).await;
+    scanning.store(false, Ordering::Release);
+    scanner.await.unwrap();
+    for result in results {
+        result.unwrap();
+    }
+    let mut fatal = fixture.fatal;
+    assert!(fatal.try_recv().is_err(), "no flow missed its activation");
+    fixture.pending.shutdown_commit_pump().await.unwrap();
+}
+
+/// A flow armed without time for its activation would be fatal when the
+/// activation misses its hold: such a flow expires unarmed instead, and its
+/// originals are dropped.
+#[tokio::test]
+async fn a_flow_without_time_for_its_activation_expires_unarmed() {
+    let mock = MockEbpfBackend::new();
+    let trace = Arc::clone(&mock.commit_trace);
+    let mut fixture = pending_fixture_with(45, mock);
+    deadline(&fixture, ACTIVATION_MARGIN / 2);
+    let result = fixture
+        .pending
+        .activate_direct(fixture.identity, fixture.lease, 0x1200)
+        .await;
+    assert!(result.is_err(), "{result:?}");
+    assert!(trace.lock().is_empty(), "nothing was armed");
+    assert!(fixture.fatal.try_recv().is_err());
+    assert_eq!(*fixture.sink.lock(), vec![TestVerdict::Drop { id: 1 }]);
+    fixture.pending.shutdown_commit_pump().await.unwrap();
+}
+
+#[test]
+fn the_activation_reserve_follows_the_recorded_work() {
+    let pump = commit::CommitPump::new();
+    // However little the work, arming leaves half the hold.
+    assert_eq!(pump.activation_reserve(0, 10, None), ACTIVATION_RESERVE_MIN);
+    // 100 ms of activation work a flow.
+    pump.record_activations(Duration::from_millis(400), 1);
+    assert_eq!(
+        pump.activation_reserve(15, 1, None),
+        ACTIVATION_MARGIN + Duration::from_millis(100) * 16
+    );
+    // And 100 ms of commit work a request.
+    pump.record_commits(Duration::from_millis(400), 1);
+    let recorded =
+        ACTIVATION_MARGIN + Duration::from_millis(100) * 3 + Duration::from_millis(100) * 13;
+    assert_eq!(pump.activation_reserve(10, 3, None), recorded);
+    // The batch's own rate counts only where it is the slower.
+    assert_eq!(
+        pump.activation_reserve(10, 3, Some(Duration::from_millis(1))),
+        recorded
+    );
+    assert_eq!(
+        pump.activation_reserve(10, 3, Some(Duration::from_millis(200))),
+        ACTIVATION_MARGIN + Duration::from_millis(200) * 3 + Duration::from_millis(100) * 13
+    );
+    pump.record_activations(Duration::from_secs(60), 1);
+    assert_eq!(pump.activation_reserve(0, 1, None), ACTIVATION_RESERVE_MAX);
+}
+
+/// A flow past half its hold is not armed, however little work its batch
+/// has lately needed: under host load the emulated R4S took up to a second
+/// from arming to activation, and flows armed with less left missed their
+/// hold.
+#[tokio::test]
+async fn a_flow_past_half_its_hold_expires_unarmed() {
+    let mock = MockEbpfBackend::new();
+    let trace = Arc::clone(&mock.commit_trace);
+    let mut fixture = pending_fixture_with(47, mock);
+    deadline(
+        &fixture,
+        ACTIVATION_RESERVE_MIN - Duration::from_millis(100),
+    );
+    let result = fixture
+        .pending
+        .activate_direct(fixture.identity, fixture.lease, 0x1200)
+        .await;
+    assert!(result.is_err(), "{result:?}");
+    assert!(trace.lock().is_empty(), "nothing was armed");
+    assert!(fixture.fatal.try_recv().is_err());
+    fixture.pending.shutdown_commit_pump().await.unwrap();
+}
+
+/// The commit still to come goes at the slower of the recorded rate and the
+/// batch's own: on the emulated R4S a firewall reload more than doubled a
+/// request's commit work, and a flow armed by the recorded rate missed its
+/// hold while the rest of its batch committed.
+#[tokio::test]
+async fn a_slow_batch_reserves_at_its_own_rate() {
+    let mut mock = MockEbpfBackend::new();
+    // The second request's commit waits 0.8 s: the batch's own rate.
+    mock.commit_item_delay = Some((1, Duration::from_millis(800)));
+    let (fixture, flows) = staged(mock, 2, Duration::from_millis(2400));
+    let mut flows = flows.into_iter();
+    let (second, second_id) = flows.next().unwrap();
+    let (third, third_id) = flows.next().unwrap();
+    let first = fixture
+        .pending
+        .activate_direct(fixture.identity, fixture.lease, 0x1200);
+    let second = fixture.pending.activate_direct(second_id, second, 0x1200);
+    let third = fixture.pending.activate_direct(third_id, third, 0x1200);
+    let (first, second, third) = tokio::join!(biased; first, second, third);
+    first.unwrap();
+    // Visited with 1.6 s left and two requests at 0.8 s each to commit.
+    assert!(second.is_err(), "{second:?}");
+    third.unwrap();
+    let mut fatal = fixture.fatal;
+    assert!(fatal.try_recv().is_err());
+    fixture.pending.shutdown_commit_pump().await.unwrap();
+}
+
+/// However long activations have taken, a flow fresh from the queue is still
+/// armed and activated: arming never withholds the whole hold, so it cannot
+/// lock every direct flow out.
+#[tokio::test]
+async fn a_fresh_flow_is_armed_however_long_activations_took() {
+    let mut fixture = pending_fixture(46);
+    fixture
+        .pending
+        .commits
+        .record_commits(Duration::from_secs(60), 1);
+    fixture
+        .pending
+        .commits
+        .record_activations(Duration::from_secs(60), 1);
+    fixture
+        .pending
+        .activate_direct(fixture.identity, fixture.lease, 0x1200)
+        .await
+        .unwrap();
+    assert!(fixture.fatal.try_recv().is_err());
+    fixture.pending.shutdown_commit_pump().await.unwrap();
+}
+
+/// Activation waits for the rest of the batch's commit, so a flow visited
+/// early in a batch reserves the commit work of the requests after it: armed
+/// with less, it missed its hold while they committed (an emulated R4S under
+/// load, 8 ms a request).
+#[tokio::test]
+async fn a_flow_reserves_the_rest_of_its_batch() {
+    let (mut fixture, second, second_id) = pair(MockEbpfBackend::new());
+    // A second of commit work a request.
+    fixture
+        .pending
+        .commits
+        .record_commits(Duration::from_secs(4), 1);
+    let remaining = Duration::from_millis(2000);
+    deadline(&fixture, remaining);
+    {
+        let cell = fixture.pending.matching_cell(second_id).unwrap();
+        let mut state = cell.state.lock();
+        let CellState::Pending { started_at, .. } = &mut *state else {
+            panic!("pending")
