+
+    /// The hold that arming must leave for the activation of a batch's flow
+    /// visited after `armed` of its flows were armed, with `remaining` of its
+    /// requests still to commit, itself included. Activation follows the rest
+    /// of the batch's commit, at the slower of the recorded rate and `rate`,
+    /// the batch's own so far, and the release of the originals of every flow
+    /// the batch arms, which comes before any of them is activated.
+    pub(super) fn activation_reserve(
+        &self,
+        armed: usize,
+        remaining: usize,
+        rate: Option<Duration>,
+    ) -> Duration {
+        let count = |n: usize| u32::try_from(n).unwrap_or(u32::MAX);
+        let recorded = *self.commit_cost.lock();
+        let commit = rate.map_or(recorded, |rate| rate.max(recorded));
+        ACTIVATION_MARGIN
+            .saturating_add(commit.saturating_mul(count(remaining)))
+            .saturating_add(
+                self.activation_cost
+                    .lock()
+                    .saturating_mul(count(armed + remaining)),
+            )
+            .clamp(ACTIVATION_RESERVE_MIN, ACTIVATION_RESERVE_MAX)
+    }
+
+    pub(super) fn record_commits(&self, elapsed: Duration, requests: usize) {
+        record(&self.commit_cost, elapsed, requests);
+    }
+
+    pub(super) fn record_activations(&self, elapsed: Duration, flows: usize) {
+        record(&self.activation_cost, elapsed, flows);
+    }
+}
+
+/// Fold `elapsed`, the work of `items`, into `cost`, a moving average per item.
+fn record(cost: &Mutex<Duration>, elapsed: Duration, items: usize) {
+    let Some(items) = u32::try_from(items).ok().filter(|&items| items > 0) else {
+        return;
+    };
+    let mut cost = cost.lock();
+    *cost = (*cost * 3 + elapsed / items) / 4;
 }
 
