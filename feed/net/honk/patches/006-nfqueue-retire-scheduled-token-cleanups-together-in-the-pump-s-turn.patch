+    /// Retire a batch of the scheduled token cleanups, waiting for the backend
+    /// in turn: the commit pump's, between its batches.
+    pub(super) async fn retire_cleanups_in_turn(&self) {
+        let _drainer = self.cleanup_drainer.lock().await;
+        let tokens = self.scheduled_tokens();
+        if tokens.is_empty() {
+            return;
+        }
+        let mut backend = self.ebpf.write().await;
+        self.retire_tokens(backend.as_mut(), &tokens);
+        drop(backend);
+        self.notify_empty_if_needed();
+    }
+
+    /// Up to a retirement batch of the scheduled token cleanups: a token
+    /// cleanup retires kernel staging alone, so they go to the backend
+    /// together, under one grace period.
+    fn scheduled_tokens(&self) -> Vec<CleanupRequest> {
+        self.scheduled_cleanups
+            .lock()
+            .iter()
+            .filter(|request| matches!(request, CleanupRequest::Token { .. }))
+            .take(RETIRE_BATCH_CAPACITY)
+            .copied()
+            .collect()
+    }
+
+    fn retire_tokens(&self, backend: &mut dyn EbpfBackend, tokens: &[CleanupRequest]) {
+        if let Ok(results) = self.retire_pending(backend, tokens) {
+            for refusal in results.into_iter().flatten() {
+                self.record_commit_mismatch(refusal);
+            }
+        }
+        let mut requests = self.scheduled_cleanups.lock();
+        for request in tokens {
+            requests.remove(request);
+        }
     }
 
