+/// `flows` flows shed before reaching the correlator: their staging seeded in
+/// the backend and their token cleanups scheduled.
+struct ShedFlows {
+    identities: Vec<PendingUdpIdentity>,
+    backend: Arc<RwLock<Box<dyn EbpfBackend>>>,
+    /// The size of each retirement batch the backend ran.
+    batches: Arc<parking_lot::Mutex<Vec<usize>>>,
+    pending: PendingUdpVerdicts,
+    _fatal: mpsc::Receiver<PendingUdpFatal>,
+}
+
+impl ShedFlows {
+    fn scheduled(flows: usize) -> Self {
+        let identities: Vec<_> = (0..flows)
+            .map(|index| {
+                let index = u16::try_from(index).unwrap();
+                PendingUdpIdentity::new(
+                    FlowKey::new(
+                        SocketAddr::from(([192, 0, 2, 10], 20_000 + index)),
+                        "198.51.100.20:443".parse().unwrap(),
+                    ),
+                    crate::ebpf::UdpFlowOwner::new(100 + u32::from(index), None).unwrap(),
+                    0,
+                )
+            })
+            .collect();
+        let mut mock = crate::ebpf::mock::MockEbpfBackend::new();
+        for identity in &identities {
+            mock.seed_staged_udp_flow(
+                &identity.tuples(),
+                retained(identity.owner.token, UdpDecisionState::Pending, 0),
+            );
+        }
+        let batches = Arc::clone(&mock.retire_batch_sizes);
+        let backend: Arc<RwLock<Box<dyn EbpfBackend>>> = Arc::new(RwLock::new(Box::new(mock)));
+        let (pending, fatal) = PendingUdpVerdicts::new(
+            Arc::clone(&backend),
+            Arc::new(UdpEndpointPool::new()),
+            Arc::new(StatsManager::new()),
+        );
+        for identity in &identities {
+            pending.schedule_cleanup(CleanupRequest::Token {
+                key: identity.key,
+                decision_token: identity.owner.token,
+            });
+        }
+        Self {
+            identities,
+            backend,
+            batches,
+            pending,
+            _fatal: fatal,
+        }
+    }
+
+    /// Every staging gone and the set empty.
+    async fn assert_retired(&self) {
+        assert!(self.pending.scheduled_cleanups.lock().is_empty());
+        let backend = self.backend.read().await;
+        for identity in &self.identities {
+            assert!(
+                backend
+                    .conn_state_lookup(&identity.tuples())
+                    .unwrap()
+                    .is_none()
+            );
+        }
+    }
+}
+
+#[tokio::test]
+async fn scheduled_token_cleanups_retire_together() {
+    // A retirement waits for one grace period however many tokens it holds;
+    // flows shed under load schedule token cleanups faster than one each can go.
+    let shed = ShedFlows::scheduled(RETIRE_BATCH_CAPACITY + 1);
+
+    shed.pending.drain_scheduled_cleanups().await;
+
+    assert_eq!(*shed.batches.lock(), vec![RETIRE_BATCH_CAPACITY, 1]);
+    shed.assert_retired().await;
+}
+
+/// The hold watchdog retires a batch of token cleanups a tick, its pause for
+/// them one grace period at most: it scans the holds after them.
+#[tokio::test]
+async fn the_watchdog_retires_a_batch_of_token_cleanups_a_tick() {
+    let shed = ShedFlows::scheduled(RETIRE_BATCH_CAPACITY + 1);
+
+    shed.pending.watchdog_tick().await;
+    assert_eq!(*shed.batches.lock(), vec![RETIRE_BATCH_CAPACITY]);
+
+    shed.pending.watchdog_tick().await;
+    assert_eq!(*shed.batches.lock(), vec![RETIRE_BATCH_CAPACITY, 1]);
+    shed.assert_retired().await;
+}
+
+/// A reader that takes the backend again as soon as it lets it go, as the
+/// ingest actor does under load, leaves a drain that only tries no turn: the
+/// commit pump retires the token cleanups between its batches, waiting its
+/// turn for the backend as for its commits.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn the_pump_retires_token_cleanups_in_its_turn() {
+    let shed = FlowKey::new(
+        SocketAddr::from(([192, 0, 2, 10], 20_000)),
+        "198.51.100.20:443".parse().unwrap(),
+    );
+    let mut mock = crate::ebpf::mock::MockEbpfBackend::new();
+    mock.seed_staged_udp_flow(&shed.tuples(), retained(33, UdpDecisionState::Pending, 0));
+    let fixture = pending_fixture_with(34, mock);
+    fixture.pending.schedule_cleanup(CleanupRequest::Token {
+        key: shed,
+        decision_token: 33,
+    });
+    let reading = Arc::new(std::sync::atomic::AtomicBool::new(true));
+    let reader = tokio::task::spawn_blocking({
+        let backend = Arc::clone(&fixture.backend);
+        let reading = Arc::clone(&reading);
+        move || {
+            while reading.load(std::sync::atomic::Ordering::Acquire) {
+                let read = backend.blocking_read();
+                std::thread::sleep(Duration::from_millis(5));
+                drop(read);
+            }
+        }
+    });
+
+    fixture
+        .pending
+        .activate_proxy(fixture.identity, &fixture.lease, 4, 0)
+        .await
+        .unwrap();
+    let retired = tokio::time::timeout(Duration::from_secs(1), async {
+        while fixture
+            .backend
+            .read()
+            .await
+            .conn_state_lookup(&shed.tuples())
+            .unwrap()
+            .is_some()
+        {
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await;
+    reading.store(false, std::sync::atomic::Ordering::Release);
+    reader.await.unwrap();
+    retired.expect("the pump retired the cleanup in its turn");
+    assert!(fixture.pending.scheduled_cleanups.lock().is_empty());
+    fixture.pending.shutdown_commit_pump().await.unwrap();
+}
