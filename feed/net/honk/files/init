#!/bin/sh /etc/rc.common
# These come first: rpcd's rc list reads START and STOP only near the top of the file.
# shellcheck disable=SC2034 # read by /etc/rc.common
USE_PROCD=1
# shellcheck disable=SC2034
START=99
# shellcheck disable=SC2034
STOP=01
#
# honk, bound to the LAN side only (honk-datapath D4, D5). honk runs an
# entry written here around the configuration (option config_file), in a copy of
# the configuration's directory, /var/run/honk, readable by root alone: honk
# resolves includes from the entry's directory, so the configuration's own
# includes resolve as they do in its directory. The entry routes the DNS of
# private addresses natively, then includes the configuration and, last, the
# firmware's settings, which honk takes over the configuration's: the interfaces
# to bind, the data directory, honk's DNS listener and the native API's token
# mode. The directory is made anew beside the running one, checked by honk, and
# only then put in its place, under /var/lock/honk.lock.
#
# honk's data directory (its state database, subscriptions and geodata) is on
# the data disk while that is mounted and writable, and in RAM otherwise: honk
# writes to it all the time, so never to the boot disk. The data disk's mount
# and unmount restart honk onto it and off it.
#
# honk starts at boot while this script is enabled, as daeuniverse's LuCI page
# switches it. The image ships it disabled, and an upgrade keeps its rc.d links
# (/lib/upgrade/keep.d/orbyt-config).
# shellcheck source=../../../utils/orbyt-data/files/lib/functions/orbyt-data.sh
. /lib/functions/orbyt-data.sh
# shellcheck source=./honk.sh
. /lib/functions/honk.sh

CONF=honk
PROG=/usr/bin/honk-core
RUN=/var/run/honk
# The firmware's two files in the directory: the entry, and its settings.
ENTRY_NAME=orbyt-entry.dae
SETTINGS_NAME=orbyt-settings.dae
ENTRY="${RUN}/${ENTRY_NAME}"
LOCK=/var/lock/honk.lock
# The LAN side: br-lan, the container bridge and the tailnet's device, which
# honk binds when they appear.
INTERFACES="br-lan, podman0, tailscale0"
# honk's data directory on the data disk, and in RAM (honk's own default).
STATE_DISK="${ORBYT_DATA}/honk"
STATE_RAM=/var/lib/honk

# state_dir [make]: honk's data directory as things are now: on the data disk
# while that is mounted and the directory there writable, made there with make;
# in RAM otherwise.
state_dir() {
	if orbyt_data_mounted &&
		{ [ -d "${STATE_DISK}" ] || { [ "${1:-}" = make ] && mkdir -m 0700 "${STATE_DISK}"; }; } &&
		[ -w "${STATE_DISK}" ]; then
		echo "${STATE_DISK}"
	else
		echo "${STATE_RAM}"
	fi
}

# write_entry <configuration file> <directory> [make]: make <directory>, a copy
# of the file's directory with the firmware's entry and settings in it; make
# makes honk's data directory on the data disk, as the service does.
write_entry() {
	file=$1
	run=$2
	# honk refuses configuration files others can read.
	umask 077
	mkdir -p "${run}" && cp -R "${file%/*}/." "${run}/" || return 1
	for name in "${ENTRY_NAME}" "${SETTINGS_NAME}"; do
		if [ -e "${run}/${name}" ]; then
			echo "${file%/*}/${name}: the name is the firmware's; rename the file" >&2
			return 1
		fi
	done
	{
		echo "# Written by /etc/init.d/honk; edit ${file} instead."
		# DNS to a private address stays native: dnsmasq answers the LAN, and
		# podman's resolver its containers (honk-datapath D4). Rules match in
		# order, the entry's first.
		printf 'routing {\n\tdip(geoip: private) && dport(53) -> direct(must)\n}\n'
		# honk merges the included files in order, and takes a setting from
		# the last that has it.
		printf 'include {\n\t%s\n\t%s\n}\n' "${file##*/}" "${SETTINGS_NAME}"
	} >"${run}/${ENTRY_NAME}" || return 1
	state=$(state_dir "${3:-}")
	{
		echo "# Written by /etc/init.d/honk: the firmware's settings."
		printf 'global {\n'
		printf '\tlan_interface: %s\n' "${INTERFACES}"
		# No WAN interface: the router's own traffic stays direct.
		printf "\twan_interface: ''\n"
		printf "\tdata_dir: '%s'\n" "${state}"
		printf '}\n'
		printf "dns {\n\tbind: '127.0.0.1:5353'\n}\n"
		# The native API, if the configuration enables it, in token mode alone and
		# never writing the configuration (honk-datapath D8): honk takes each of
		# these from the last file that sets it, and then refuses an API without
		# a token (secret).
		printf 'experimental {\n\tnative_api {\n'
		printf '\t\tpassword_auth: false\n'
		printf '\t\tallow_anonymous_loopback: false\n'
		printf '\t\tconfig_write: false\n'
		printf '\t}\n}\n'
	} >"${run}/${SETTINGS_NAME}"
}

# prepare: the service's entry made anew, checked by honk, and put in place.
# shellcheck disable=SC2154 # config_get assigns config_file
prepare() {
	config_get config_file config config_file /etc/honk/config.dae
	(
		flock 9
		rm -rf "${RUN}.new" "${RUN}.old"
		write_entry "${config_file}" "${RUN}.new" make &&
			"${PROG}" --config "${RUN}.new/${ENTRY_NAME}" check || exit 1
		if [ -e "${RUN}" ]; then
			mv "${RUN}" "${RUN}.old" || exit 1
		fi
		mv "${RUN}.new" "${RUN}" && rm -rf "${RUN}.old"
	) 9>"${LOCK}"
}

extra_command "check" "<file>: check a configuration as the service would run it"

# check <configuration file>: honk's check of the entry the service would make
# around the file, in a directory of its own (config-push validates this way).
check() {
	file=${1:?usage: /etc/init.d/honk check <configuration file>}
	case ${file} in
		/*) ;;
		*)
			echo "${file}: not an absolute path" >&2
			return 1
			;;
	esac
	run=$(mktemp -d /tmp/honk-check.XXXXXX) || return 1
	write_entry "${file}" "${run}" && "${PROG}" --config "${run}/${ENTRY_NAME}" check
	status=$?
	rm -rf "${run}"
	return "${status}"
}

start_service() {
	config_load "${CONF}"
	prepare || return 1

	# aya pins its maps below /sys/fs/bpf, which OpenWrt does not mount by
	# itself. It stays mounted on stop: other tools may share it.
	grep -qs ' /sys/fs/bpf bpf ' /proc/mounts || mount -t bpf bpf /sys/fs/bpf

	procd_open_instance "${CONF}"
	# The instance sets up its service cgroup itself (honk-start).
	procd_set_param command /usr/libexec/honk-start --config "${ENTRY}" --disable-timestamp
	# honk budgets its flow admission from RLIMIT_NOFILE. No core dumps: they
	# would land in /tmp, which is memory, one for every crash procd respawns.
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param respawn
	# honk's graceful shutdown can take over 10 s; its systemd unit allows 30.
	procd_set_param term_timeout 30
	procd_set_param stdout 1
	procd_set_param stderr 1
	# honk keeps the time zone (its geodata update schedule) TZ names, and
	# OpenWrt keeps it in /etc/TZ only. A change takes a restart.
	if [ -s /etc/TZ ]; then
		zone=$(cat /etc/TZ)
		procd_set_param env TZ="${zone}"
	fi
	procd_close_instance
}

# reload_service: a stopped honk stays stopped. A running one is pinned anew and
# rereads its entry on SIGHUP, which honk applies or, for a field that needs a
# restart, refuses (config-push restarts).
reload_service() {
	procd_running "${CONF}" "${CONF}" || return 0
	config_load "${CONF}"
	prepare || return 1
	config_get_bool cpu_pinning config cpu_pinning 0
	# shellcheck disable=SC2154 # config_get_bool assigns cpu_pinning
	honk_pin "${cpu_pinning}"
	procd_send_signal "${CONF}" "${CONF}" HUP
}

service_triggers() {
	procd_add_reload_trigger "${CONF}"
	procd_add_restart_mount_trigger "${STATE_DISK}"
	procd_add_restart_unmount_trigger "${STATE_DISK}"
}
