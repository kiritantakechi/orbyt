{#
	luci-theme-orbyt: Orbyt's mark, the ring node (orbyt-theme D4), inline so that its
	colors follow the mode: the stream gradient's stops read --stream-a, -b and -c
	from the stylesheet. The including template passes an id that keeps the
	gradient's and the mask's ids unique on the page.
	Licensed under the Apache License 2.0, as LuCI.
-#}

<svg class="orbyt-mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
	<defs>
		<linearGradient id="orbyt-{{ id }}-stream" gradientUnits="userSpaceOnUse" x1="8" y1="8" x2="56" y2="56">
			<stop class="stream-a" offset="0"/>
			<stop class="stream-b" offset=".5"/>
			<stop class="stream-c" offset="1"/>
		</linearGradient>
		<mask id="orbyt-{{ id }}-gap">
			<rect width="64" height="64" fill="#fff"/>
			<circle cx="46.85" cy="17.15" r="9.6" fill="#000"/>
		</mask>
	</defs>
	<circle cx="32" cy="32" r="21" fill="none" stroke="url(#orbyt-{{ id }}-stream)" stroke-width="6.5" mask="url(#orbyt-{{ id }}-gap)"/>
	<circle cx="46.85" cy="17.15" r="6.4" fill="url(#orbyt-{{ id }}-stream)"/>
</svg>
