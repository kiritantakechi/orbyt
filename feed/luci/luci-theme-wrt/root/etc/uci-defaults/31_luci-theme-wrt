#!/bin/sh
# The image's theme is LuCI's default once, when it first arrives: on a fresh
# install, after bootstrap's own script has set its default, and on the first boot
# of an upgrade that brings it. Once luci.themes.Wrt exists, the administrator's
# choice of theme stays (luci-theme-wrt D8).

uci -q get luci.themes.Wrt >/dev/null && exit 0
uci set luci.themes.Wrt=/luci-static/wrt
uci set luci.main.mediaurlbase=/luci-static/wrt
uci commit luci
