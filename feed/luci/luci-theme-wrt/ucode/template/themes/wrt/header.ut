{#
	luci-theme-wrt: the page's shell (luci-theme-wrt D2, D3): the sidebar, filled by
	menu-wrt.js, the top bar with the page's place, LuCI's indicators and the
	light/dark switch, and #maincontent. A blank page (the login) gets none of it.
	Licensed under the Apache License 2.0, as LuCI.
-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board') ?? {};
	const hostname = striptags(boardinfo.hostname ?? '?');

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
		<script>
			/* Dark mode as LuCI's modules read it, before the first paint: pinned in
			 * this browser, else the browser's preference, which it then follows. */
			(function () {
				var root = document.documentElement;
				var query = window.matchMedia('(prefers-color-scheme: dark)');
				var key = 'luci-theme-wrt';
				var pinned = null;

				try { pinned = localStorage.getItem(key); } catch (e) {}

				function apply() {
					var dark = pinned === 'dark' || (pinned !== 'light' && query.matches);
					root.setAttribute('data-darkmode', String(dark));
					root.setAttribute('data-theme-choice', pinned || 'auto');
				}

				query.addEventListener('change', apply);
				apply();

				window.wrtTheme = function (choice) {
					pinned = (choice === 'light' || choice === 'dark') ? choice : null;
					try {
						if (pinned) localStorage.setItem(key, pinned);
						else localStorage.removeItem(key);
					} catch (e) {}
					apply();
				};
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="darkreader-lock">
		<link rel="stylesheet" href="{{ media }}/cascade.css">
		<link rel="icon" href="{{ media }}/logo.svg" sizes="any">
		{% if (dispatched?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ dispatched.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>

	<body class="lang_{{ dispatcher.lang }}" data-page="{{ entityencode(join('-', length(ctx.request_path) ? ctx.request_path : ctx.path), true) }}">
		{% if (!blank_page): %}
		<div class="shell">
			<aside class="sidebar" id="sidebar" aria-label="{{ _('Menu') }}">
				<a class="brand" href="/">
					<span class="brand-mark" aria-hidden="true">wrt</span>
					<span class="brand-text">
						<span class="brand-name">{{ hostname }}</span>
						<span class="brand-model">{{ striptags(boardinfo.model ?? '') }}</span>
					</span>
				</a>
				<nav id="mainmenu" class="mainmenu"></nav>
				<div class="sidebar-foot">
					<span>{{ striptags(version.distname ?? '') }} {{ striptags(version.distversion ?? '') }}</span>
					<span class="mono">{{ striptags(version.distrevision ?? '') }}</span>
				</div>
			</aside>
			<div class="scrim" id="scrim"></div>

			<div class="main">
				<header class="topbar">
					<button class="icon-btn menu-toggle" id="menu-toggle" type="button" aria-controls="sidebar" aria-expanded="false" aria-label="{{ _('Menu') }}">
						<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
					</button>
					<nav class="crumbs" id="crumbs" aria-label="{{ _('Navigation') }}"></nav>
					<div class="spacer"></div>
					<div id="indicators"></div>
					{# Bare strings are luci-base's, in all its languages. luci-base has no
						plain Light, Dark or Appearance, so these come from the theme's own
						catalog (po/), under the context wrt. #}
					<div class="segmented" id="theme-switch" role="group" aria-label="{{ _('Appearance', 'wrt') }}">
						<button type="button" data-choice="auto" title="{{ _('Automatic') }}">
							<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none"/></svg>
							<span class="label-text">{{ _('Automatic') }}</span>
						</button>
						<button type="button" data-choice="light" title="{{ _('Light', 'wrt') }}">
							<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
							<span class="label-text">{{ _('Light', 'wrt') }}</span>
						</button>
						<button type="button" data-choice="dark" title="{{ _('Dark', 'wrt') }}">
							<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
							<span class="label-text">{{ _('Dark', 'wrt') }}</span>
						</button>
					</div>
				</header>

				<div id="maincontent" class="container">
					{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
						<div class="alert-message warning">
							<h4>{{ _('No password set!') }}</h4>
							<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
							{% if (dispatcher.lookup("admin/system/admin")): %}
							<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
							{% endif %}
						</div>
					{% endif %}

					{% if (boardinfo.rootfs_type == "initramfs"): %}
						<div class="alert-message warning">
							<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
							<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
							{% if (dispatcher.lookup("admin/system/flash")): %}
							<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
							{% endif %}
						</div>
					{% endif %}

					<noscript>
						<div class="alert-message warning">
							<h4>{{ _('JavaScript required!') }}</h4>
							<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
						</div>
					</noscript>

					<div id="tabmenu" style="display:none"></div>
		{% endif %}
