#!/bin/sh /etc/rc.common
# Give a trial boot its deadline, before any other boot script can hold it off.

# shellcheck disable=SC2034 # read by /etc/rc.common
START=00
# shellcheck disable=SC2034
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/orbyt-trial
	procd_close_instance
}
