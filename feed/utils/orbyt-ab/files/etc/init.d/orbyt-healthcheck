#!/bin/sh /etc/rc.common
# Check the health of this boot once: every check again until all pass or the
# time is up, so a service may come up after the check began (firmware-hygiene
# D2).

# shellcheck disable=SC2034 # read by /etc/rc.common
START=99
# shellcheck disable=SC2034
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/orbyt-healthcheck
	procd_close_instance
}
